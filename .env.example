# TEAKLE — Environment Variables

# Database
DATABASE_PATH=./data/teakle.db

# Session
SESSION_SECRET=your-random-secret-here-min-32-chars

# Set to 'true' for local HTTP testing in production mode (npm run start).
# In real production behind HTTPS reverse proxy, do NOT set this.
# ALLOW_INSECURE_SESSION=true

# Admin initialization (used by: node scripts/init-admin.js)
#   Without flags: creates account if absent
#   With --reset:  also updates password if hash does not match
# ADMIN_EMAIL=admin@your-domain.com
# ADMIN_PASSWORD=your-secure-password

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Media uploads (local development only — not production-persistent)
MEDIA_UPLOAD_DIR=./public/uploads/media

# Backups (default: ./backups)
# BACKUP_DIR=./backups

# Email provider (default: none — emails are logged but not sent)
# Supported: 'none', 'resend', 'sendgrid'
# EMAIL_PROVIDER=none
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_API_KEY=your-email-api-key

# Payment provider (default: none — payments are recorded but not processed)
# Supported: 'none', 'razorpay', 'stripe'
# PAYMENT_PROVIDER=none
# PAYMENT_KEY_ID=your-payment-key-id
# PAYMENT_KEY_SECRET=your-payment-key-secret
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
